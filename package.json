{
  "name": "dsh-jailbreak",
  "version": "0.1.0",
  "description": "DSH 提示词注入破甲插件：只改 system-prompt 装配，不写宿主文件、无客户端 UI、不注册工具、不碰审批与沙箱。",
  "type": "module",
  "main": "lib/index.mjs",
  "exports": {
    ".": "./lib/index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "LICENSE-dsh-purge",
    "docs"
  ],
  "license": "MIT",
  "author": "cwen63970-coder",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cwen63970-coder/dsh-jailbreak.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "prompt",
    "jailbreak",
    "deepseek-harness"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dshTarget": "0.2.1-rc.2",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
